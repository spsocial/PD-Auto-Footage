{
  "manifest_version": 3,
  "name": "PD Auto Footage",
  "version": "0.8.3",
  "description": "PD Auto Footage — สร้างคลิปโฆษณาแนวฟุตเทจมืออาชีพ + เสียงพากย์ + ซับ + เพลง โพส TikTok ปักตะกร้าอัตโนมัติ",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "scripting",
    "sidePanel",
    "downloads",
    "tabs",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "https://flow-content.google/*",
    "https://flow.google.com/*",
    "https://labs.google/*",
    "https://aisandbox-pa.googleapis.com/*",
    "https://www.tiktok.com/*",
    "https://tiktok.com/*",
    "https://shop.tiktok.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://pd-auto-ai-gateway.filmbancha127.workers.dev/*",
    "https://app.pd-voiceclone.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokcdn-us.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "action": {
    "default_title": "PD Auto Footage"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/*",
        "https://flow.google.com/*"
      ],
      "js": [
        "content/flow-hook.js",
        "content/flow-api.js",
        "content/flow-api-new.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://labs.google/*",
        "https://flow.google.com/*"
      ],
      "js": [
        "content/flow-merge-new.js",
        "content/vip-engine.js",
        "content/mini-flow.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/ffmpeg/*",
        "assets/fonts/*",
        "assets/music/*",
        "assets/sfx/*",
        "content/tiktok-injected.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
